<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image
      class="icon"
      src="{{selected === index ? item.selectedIcon : item.icon}}"
      mode="aspectFit"
    />
    <view class="text {{selected === index ? 'active' : ''}}">{{item.text}}</view>
  </view>
</view>
