.page {
  height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: #f4f7fb;
}

.time {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 14rpx 2rpx 22rpx;
  padding: 0 10rpx;
}

.hello {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-align: center;
}

.date {
  margin-top: 6rpx;
  color: #7a8499;
  font-size: 24rpx;
  text-align: center;
}

.avatar {
  position: relative;
  width: 92rpx;
  height: 92rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  object-fit: contain;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(26, 54, 93, 0.15);
}

.avatar-badge {
  position: absolute;
  top: 0;
  right: 0;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ff4d4f;
  border: 4rpx solid #ffffff;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 56, 109, 0.06);
}

.balance-card {
  background: linear-gradient(120deg, #12b8c9, #1d5fff);
  color: #ffffff;
}

.balance-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 26rpx;
  opacity: 0.95;
}

.wallet-icon {
  font-size: 36rpx;
}

.balance {
  font-size: 66rpx;
  font-weight: 700;
  margin: 16rpx 0 22rpx;
}

.row {
  display: flex;
  justify-content: space-between;
}

.sub-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.sub-value {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  text-align: center;
  padding: 0 10rpx;
}

.action-item {
  font-size: 24rpx;
  color: #303133;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
}

.action-dot {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10rpx;
}

.action-icon {
  width: 44rpx;
  height: 44rpx;
}

.warn-card {
  border-left: 8rpx solid #ff5151;
  background: linear-gradient(180deg, #fff9f9, #fff);
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.warn-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  background: #f23d3d;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 6rpx;
}

.warn-icon {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

.warn-content {
  flex: 1;
}

.warn-title {
  color: #d82f2f;
  font-size: 30rpx;
  font-weight: 700;
}

.warn-desc {
  color: #9a4a4a;
  font-size: 24rpx;
  margin-top: 8rpx;
  line-height: 1.7;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.link {
  color: #1d5fff;
  font-size: 26rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.record-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.record-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.record-icon-text {
  font-size: 24rpx;
  font-weight: 700;
}

.record-icon-food {
  background: #fff8db;
  color: #e6b200;
}

.record-icon-bus {
  background: #eaf2ff;
  color: #2d6cff;
}

.record-icon-study {
  background: #f3eaff;
  color: #7a3dfc;
}

.record-icon-fun {
  background: #ffeef2;
  color: #e64980;
}

.record-icon-daily {
  background: #ecfff4;
  color: #16a085;
}

.record-icon-other {
  background: #f1f3f5;
  color: #6c757d;
}

.record-title {
  font-size: 30rpx;
  color: #202124;
}

.record-note {
  margin-top: 6rpx;
  color: #8c8c8c;
  font-size: 24rpx;
}

.income {
  color: #0ea86e;
  font-weight: 600;
}

.expense {
  color: #202124;
  font-weight: 600;
  font-size: 30rpx;
}

.empty {
  color: #9aa0a6;
  padding: 32rpx 0;
  text-align: center;
}

.export-btn {
  width: 100%;
  height: 84rpx;
  margin: 10rpx 0 120rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #1b56ff, #0f90ff);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 24rpx rgba(27, 86, 255, 0.25);
}

.export-btn::after {
  border: none;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.28);
  z-index: 1000;
}

.panel {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 24rpx;
  z-index: 1001;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.18);
  max-height: calc(100vh - 280rpx);
  overflow-y: auto;
  box-sizing: border-box;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  text-align: center;
  color: #202124;
}

.panel-tip {
  color: #7a8499;
  font-size: 24rpx;
  margin-bottom: 10rpx;
  text-align: center;
  padding: 0 20rpx;
}

.seg {
  display: flex;
  background: #f1f4f8;
  border-radius: 999rpx;
  padding: 8rpx;
  margin: 0 20rpx 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  color: #607089;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.seg-active {
  color: #fff;
  background: linear-gradient(135deg, #16b8c8, #1f6bff);
  box-shadow: 0 4rpx 12rpx rgba(22, 184, 200, 0.3);
}

.panel-input,
.panel-textarea {
  background: #f4f6f9;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  margin: 12rpx 20rpx 0;
  transition: all 0.3s ease;
}

.panel-input:focus,
.panel-textarea:focus {
  background: #e8f0fe;
  box-shadow: 0 0 0 2rpx rgba(29, 95, 255, 0.1);
}

.panel-textarea {
  min-height: 180rpx;
  max-height: 320rpx;
}

.record-btn {
  margin: 12rpx 20rpx 0;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #f1f4f8;
  color: #607089;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.record-btn:active {
  background: #e8f0fe;
  color: #1f6bff;
}

.panel-btn {
  margin: 16rpx 20rpx 16rpx;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 45rpx;
  background: linear-gradient(135deg, #16b8c8, #1f6bff);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 12rpx 24rpx rgba(22, 184, 200, 0.3);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.panel-btn:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 16rpx rgba(22, 184, 200, 0.2);
}

.panel-btn::after {
  border: none;
}

.filter-row {
  display: flex;
  gap: 10rpx;
  margin: 0 20rpx 12rpx;
  justify-content: center;
}

.filter-item {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f1f4f8;
  color: #65768e;
  font-size: 24rpx;
  text-align: center;
}

.f-active {
  background: #1f6bff;
  color: #fff;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  border-bottom: 1rpx solid #eef2f7;
  font-size: 26rpx;
}


