.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 40rpx;
  background: #f1f3f7;
}

.nav-title {
  text-align: center;
  color: #242a36;
  font-size: 30rpx;
  margin: 6rpx 0 14rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  margin: 8rpx 0 8rpx;
}

.subtitle {
  color: #7a8499;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.card {
  background: #f8f9fb;
  border-radius: 22rpx;
  padding: 22rpx;
  box-shadow: 0 4rpx 12rpx rgba(23, 45, 90, 0.06);
}

.type-row {
  display: flex;
  background: #eceef3;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  color: #666;
  font-size: 34rpx;
  font-weight: 500;
}

.type-item.active {
  background: linear-gradient(135deg, #16b8c8, #1f6bff);
  color: #fff;
}

.field {
  margin-bottom: 18rpx;
}

.label {
  font-size: 30rpx;
  color: #454b57;
  margin-bottom: 8rpx;
  font-weight: 600;
  line-height: 1.35;
}

.input,
.textarea,
.picker {
  width: 100%;
  box-sizing: border-box;
  background: #f1f2f5;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  font-size: 30rpx;
  color: #2a2f3a;
  line-height: 1.35;
  min-height: 64rpx;
}

.textarea {
  min-height: 200rpx;
}

.placeholder {
  color: #a2a8b3;
  font-size: 30rpx;
  line-height: 1.35;
}

.submit-btn {
  width: 420rpx;
  height: 78rpx;
  margin-top: 24rpx;
  background: linear-gradient(135deg, #16b8c8, #1f6bff);
  color: #fff;
  border-radius: 999rpx;
  font-size: 42rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn::after {
  border: none;
}
